# Copy to .env.local and fill in. Never commit real values.

# Postgres (on Railway set automatically as a reference to the postgres service)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_coding_exam

# Self-hosted LLM (Qwen 3.6 on vLLM, OpenAI-compatible API)
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=Qwen/Qwen3.6
LLM_API_KEY=
