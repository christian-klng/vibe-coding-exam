# Copy to .env.local and fill in. Never commit real values.

# Postgres (local: docker compose up -d; in Coolify the internal URL of the PostgreSQL resource)
DATABASE_URL=postgres://postgres:postgres@localhost:54335/vibe_coding_exam

# Better Auth
BETTER_AUTH_SECRET=   # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# E-mail (verification, password reset). Without RESEND_API_KEY, links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Vibe Coding Exam <noreply@example.com>"

# GitHub API (optional locally). Without a token GitHub allows only 60 requests per hour and IP.
# Create a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

# Self-hosted LLM (Qwen 3.6 on vLLM, OpenAI-compatible API)
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=Qwen/Qwen3.6
LLM_API_KEY=
