# Copy to .env.local and fill in. Never commit real values.

# Postgres (local: docker compose up -d; in Coolify the internal URL of the PostgreSQL resource)
DATABASE_URL=postgres://postgres:postgres@localhost:54335/vibe_coding_exam

# Better Auth
BETTER_AUTH_SECRET=   # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# E-mail via any SMTP mailbox (verification, password reset), e.g. IONOS: smtp.ionos.de, port 587.
# Without SMTP_HOST, links are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be the mailbox's own address (or an alias of it), otherwise IONOS rejects the message.
EMAIL_FROM="Vibe Coding Exam <kurs@example.com>"

# GitHub API (optional locally). Without a token GitHub allows only 60 requests per hour and IP.
# Create a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

# Admins by e-mail address, comma-separated. Also works for existing accounts; the admin area
# can grant the role to further people. Leave empty to use only "npm run admin:grant".
ADMIN_EMAILS=

# Encrypts secrets stored by the admin area. Generate with: openssl rand -base64 32
# Web and worker need the same value. Do not change it, or stored secrets must be entered again.
SETTINGS_ENCRYPTION_KEY=

# Self-hosted LLM (Qwen 3.6 on vLLM, OpenAI-compatible API).
# Values entered in the admin area take precedence over these.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=Qwen/Qwen3.6
LLM_API_KEY=
# How many checks run at the same time. Depends on what the LLM server can handle.
CHECK_CONCURRENCY=1
